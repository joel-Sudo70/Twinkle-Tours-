document.addEventListener("DOMContentLoaded", function () {

    const bookingForm = document.querySelector(".booking-form");

    if (bookingForm) {
        bookingForm.addEventListener("submit", function (event) {
            event.preventDefault();
            sendBookingByEmail();
        });
    }

});


/* =========================================================
   EMAIL BOOKING
========================================================= */

function sendBookingByEmail() {

    const name = document.getElementById("booking-name").value.trim();
    const email = document.getElementById("booking-email").value.trim();
    const phone = document.getElementById("booking-phone").value.trim();
    const destination = document.getElementById("destination").value;
    const travelDate = document.getElementById("travel-date").value;
    const travelers = document.getElementById("travelers").value;
    const message = document.getElementById("booking-message").value.trim();

    if (!name || !email || !phone || !destination || !message) {
        alert("Please complete the required booking details first.");
        return;
    }

    const subject =
        "Twinkle Tours Booking - " + destination;

    const body =
        "Hello Twinkle Tours,\n\n" +
        "I would like to book a trip.\n\n" +
        "Name: " + name + "\n" +
        "Email: " + email + "\n" +
        "Phone / WhatsApp: " + phone + "\n" +
        "Destination: " + destination + "\n" +
        "Preferred Travel Date: " + (travelDate || "Not specified") + "\n" +
        "Number of Travelers: " + (travelers || "Not specified") + "\n" +
        "Additional Information: " + message +
        "\n\nThank you. I look forward to hearing from you.";

    const mailtoURL =
        "mailto:lumwachi03@gmail.com" +
        "?subject=" + encodeURIComponent(subject) +
        "&body=" + encodeURIComponent(body);

    window.location.href = mailtoURL;
}


